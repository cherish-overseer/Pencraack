generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================================================
// 1. USERS, ROLES & AUTHENTICATION
// ========================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id                BigInt       @id @default(autoincrement())
  username          String       @unique @db.VarChar(50)
  email             String       @unique @db.VarChar(191)
  passwordHash      String       @map("password_hash") @db.VarChar(255)
  status            UserStatus   @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?    @map("email_verified_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  profile           UserProfile?
  roles             UserRole[]
  refreshTokens     RefreshToken[]
  contents          Content[]
  likes             Like[]
  bookmarks         Bookmark[]
  comments          Comment[]
  wallet            Wallet?
  withdrawals       Withdrawal[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  // Social graph
  following         Follow[]     @relation("UserFollowing")
  followers         Follow[]     @relation("UserFollowers")

  // Gifts
  sentGifts         Gift[]       @relation("GiftSender")
  receivedGifts     Gift[]       @relation("GiftRecipient")

  // Service requests
  customerRequests  ServiceRequest[] @relation("CustomerRequests")
  assignedRequests  ServiceRequest[] @relation("AssignedStaff")
  createdQuotes     ServiceQuote[]   @relation("QuoteCreator")
  adminNotes        ServiceNote[]    @relation("NoteAuthor")
  reportsSubmitted  Report[]         @relation("ReportReporter")

  @@map("users")
}

model UserProfile {
  userId     BigInt   @id @map("user_id")
  fullName   String   @map("full_name") @db.VarChar(100)
  avatarUrl  String?  @map("avatar_url") @db.VarChar(500)
  bio        String?  @db.Text
  country    String?  @db.VarChar(100)
  phone      String?  @db.VarChar(30)
  website    String?  @db.VarChar(255)
  twitter    String?  @db.VarChar(100)
  instagram  String?  @db.VarChar(100)
  linkedin   String?  @db.VarChar(100)
  isWriter   Boolean  @default(false) @map("is_writer")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(50) // SUPER_ADMIN, CONTENT_ADMIN, SERVICE_ADMIN, FINANCE_ADMIN, WRITER, READER
  description String?    @db.VarChar(255)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId Int    @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenHash])
  @@map("refresh_tokens")
}

// ========================================================
// 2. CONTENT (BLOGS, STORIES, POEMS, COMICS)
// ========================================================

enum ContentType {
  BLOG
  STORY
  POEM
  COMIC
}

enum ContentStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
  SUSPENDED
}

model Category {
  id       Int         @id @default(autoincrement())
  name     String      @unique @db.VarChar(100)
  slug     String      @unique @db.VarChar(100)
  type     ContentType
  contents Content[]

  @@map("categories")
}

model Tag {
  id       BigInt       @id @default(autoincrement())
  name     String       @unique @db.VarChar(50)
  slug     String       @unique @db.VarChar(50)
  contents ContentTag[]

  @@map("tags")
}

model Content {
  id            BigInt        @id @default(autoincrement())
  authorId      BigInt        @map("author_id")
  categoryId    Int?          @map("category_id")
  type          ContentType
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  excerpt       String?       @db.Text
  bodyContent   String?       @map("body_content") @db.LongText
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(500)
  readTime      String?       @map("read_time") @db.VarChar(20)
  status        ContentStatus @default(DRAFT)
  isFeatured    Boolean       @default(false) @map("is_featured")
  isEditorsPick Boolean       @default(false) @map("is_editors_pick")
  viewsCount    Int           @default(0) @map("views_count")
  likesCount    Int           @default(0) @map("likes_count")
  publishedAt   DateTime?     @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          ContentTag[]
  comicPages    ComicPage[]
  likes         Like[]
  bookmarks     Bookmark[]
  comments      Comment[]

  @@index([type, status])
  @@index([publishedAt])
  @@map("contents")
}

model ComicPage {
  id         BigInt   @id @default(autoincrement())
  comicId    BigInt   @map("comic_id")
  pageNumber Int      @map("page_number")
  imageUrl   String   @map("image_url") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  comic      Content  @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([comicId, pageNumber])
  @@map("comic_pages")
}

model ContentTag {
  contentId BigInt  @map("content_id")
  tagId     BigInt  @map("tag_id")

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@map("content_tags")
}

// ========================================================
// 3. SOCIAL INTERACTIONS & LIBRARIES
// ========================================================

model Like {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  contentId BigInt   @map("content_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("likes")
}

model Bookmark {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  contentId BigInt   @map("content_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("bookmarks")
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  FLAGGED
}

model Comment {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @map("user_id")
  contentId       BigInt        @map("content_id")
  parentCommentId BigInt?       @map("parent_comment_id")
  commentText     String        @map("comment_text") @db.Text
  status          CommentStatus @default(VISIBLE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]     @relation("CommentReplies")

  @@map("comments")
}

model Follow {
  followerId  BigInt   @map("follower_id")
  followingId BigInt   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

// ========================================================
// 4. SERVICES & DYNAMIC SERVICE REQUEST ENGINE
// ========================================================

enum ServiceCategory {
  CREATIVE
  ACADEMIC
}

enum PriceType {
  FIXED
  STARTING_FROM
  CUSTOM_QUOTE
}

model Service {
  id             Int              @id @default(autoincrement())
  category       ServiceCategory
  name           String           @unique @db.VarChar(100)
  slug           String           @unique @db.VarChar(100)
  shortDesc      String           @map("short_desc") @db.VarChar(255)
  fullDesc       String?          @map("full_desc") @db.Text
  priceType      PriceType        @default(STARTING_FROM) @map("price_type")
  startingPrice  Decimal          @default(0.00) @map("starting_price") @db.Decimal(12, 2)
  currency       String           @default("NGN") @db.VarChar(10)
  turnaroundTime String?          @map("turnaround_time") @db.VarChar(50)
  guarantee      String?          @db.VarChar(255)
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  fields         ServiceField[]
  requests       ServiceRequest[]

  @@map("services")
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  FILE
  DATE
}

model ServiceField {
  id           Int         @id @default(autoincrement())
  serviceId    Int         @map("service_id")
  fieldKey     String      @map("field_key") @db.VarChar(50)
  fieldLabel   String      @map("field_label") @db.VarChar(100)
  fieldType    FieldType   @map("field_type")
  isRequired   Boolean     @default(false) @map("is_required")
  displayOrder Int         @default(0) @map("display_order")
  optionsJson  Json?       @map("options_json")

  service      Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  values       ServiceRequestField[]

  @@unique([serviceId, fieldKey])
  @@map("service_fields")
}

enum ServiceRequestStatus {
  NEW
  REVIEWING
  AWAITING_CUSTOMER
  QUOTED
  PAYMENT_PENDING
  PAID
  ASSIGNED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
  REJECTED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

model ServiceRequest {
  id              BigInt               @id @default(autoincrement())
  referenceCode   String               @unique @map("reference_code") @db.VarChar(50)
  serviceId       Int                  @map("service_id")
  customerUserId  BigInt?              @map("customer_user_id")
  customerName    String               @map("customer_name") @db.VarChar(100)
  customerEmail   String               @map("customer_email") @db.VarChar(191)
  customerPhone   String?              @map("customer_phone") @db.VarChar(50)
  budgetEstimate  String?              @map("budget_estimate") @db.VarChar(100)
  deadlineDate    DateTime?            @map("deadline_date")
  status          ServiceRequestStatus @default(NEW)
  paymentStatus   PaymentStatus        @default(UNPAID) @map("payment_status")
  assignedStaffId BigInt?              @map("assigned_staff_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  service         Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customerUser    User?                @relation("CustomerRequests", fields: [customerUserId], references: [id], onDelete: SetNull)
  assignedStaff   User?                @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  fields          ServiceRequestField[]
  files           ServiceRequestFile[]
  quotes          ServiceQuote[]
  notes           ServiceNote[]

  @@index([referenceCode])
  @@index([customerEmail])
  @@map("service_requests")
}

model ServiceRequestField {
  id         BigInt        @id @default(autoincrement())
  requestId  BigInt        @map("request_id")
  fieldId    Int?          @map("field_id")
  fieldName  String        @map("field_name") @db.VarChar(100)
  fieldValue String        @map("field_value") @db.LongText

  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  field      ServiceField?  @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@map("service_request_fields")
}

model ServiceRequestFile {
  id             BigInt         @id @default(autoincrement())
  requestId      BigInt         @map("request_id")
  fileName       String         @map("file_name") @db.VarChar(255)
  fileUrl        String         @map("file_url") @db.VarChar(500)
  fileSizeBytes  BigInt?        @map("file_size_bytes")
  mimeType       String?        @map("mime_type") @db.VarChar(100)
  uploadedAt     DateTime       @default(now()) @map("uploaded_at")

  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("service_request_files")
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model ServiceQuote {
  id                     BigInt         @id @default(autoincrement())
  requestId              BigInt         @map("request_id")
  amount                 Decimal        @db.Decimal(12, 2)
  currency               String         @default("NGN") @db.VarChar(10)
  description            String?        @db.Text
  estimatedDeliveryDays  Int?           @map("estimated_delivery_days")
  expiresAt              DateTime?      @map("expires_at")
  status                 QuoteStatus    @default(PENDING)
  createdByAdminId       BigInt         @map("created_by_admin_id")
  createdAt              DateTime       @default(now()) @map("created_at")

  request                ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdByAdmin         User           @relation("QuoteCreator", fields: [createdByAdminId], references: [id], onDelete: Cascade)

  @@map("service_quotes")
}

model ServiceNote {
  id        BigInt         @id @default(autoincrement())
  requestId BigInt         @map("request_id")
  adminId   BigInt         @map("admin_id")
  note      String         @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  admin     User           @relation("NoteAuthor", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("service_notes")
}

// ========================================================
// 5. PAYMENTS, GIFTS, WALLETS & LEDGER
// ========================================================

model Wallet {
  id               BigInt         @id @default(autoincrement())
  userId           BigInt         @unique @map("user_id")
  availableBalance Decimal        @default(0.00) @map("available_balance") @db.Decimal(12, 2)
  pendingBalance   Decimal        @default(0.00) @map("pending_balance") @db.Decimal(12, 2)
  totalEarned      Decimal        @default(0.00) @map("total_earned") @db.Decimal(12, 2)
  totalWithdrawn   Decimal        @default(0.00) @map("total_withdrawn") @db.Decimal(12, 2)
  currency         String         @default("NGN") @db.VarChar(10)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries    WalletLedger[]

  @@map("wallets")
}

enum TransactionType {
  WRITER_GIFT
  SERVICE_PAYMENT
  WITHDRAWAL
  REFUND
  PLATFORM_FEE
  ADJUSTMENT
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  INTERNAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

model Transaction {
  id                BigInt            @id @default(autoincrement())
  reference         String            @unique @db.VarChar(100)
  type              TransactionType
  amount            Decimal           @db.Decimal(12, 2)
  feeAmount         Decimal           @default(0.00) @map("fee_amount") @db.Decimal(12, 2)
  netAmount         Decimal           @map("net_amount") @db.Decimal(12, 2)
  currency          String            @default("NGN") @db.VarChar(10)
  provider          PaymentProvider   @default(PAYSTACK)
  providerReference String?           @map("provider_reference") @db.VarChar(100)
  status            TransactionStatus @default(PENDING)
  metadataJson      Json?             @map("metadata_json")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  ledgerEntries     WalletLedger[]
  gift              Gift?

  @@index([reference])
  @@map("transactions")
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

model WalletLedger {
  id            BigInt          @id @default(autoincrement())
  walletId      BigInt          @map("wallet_id")
  transactionId BigInt?         @map("transaction_id")
  entryType     LedgerEntryType @map("entry_type")
  amount        Decimal         @db.Decimal(12, 2)
  balanceBefore Decimal         @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(12, 2)
  description   String          @db.VarChar(255)
  createdAt     DateTime        @default(now()) @map("created_at")

  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction   Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@map("wallet_ledger")
}

model Gift {
  id              BigInt      @id @default(autoincrement())
  senderUserId    BigInt      @map("sender_user_id")
  recipientUserId BigInt      @map("recipient_user_id")
  transactionId   BigInt      @unique @map("transaction_id")
  grossAmount     Decimal     @map("gross_amount") @db.Decimal(12, 2)
  platformFee     Decimal     @map("platform_fee") @db.Decimal(12, 2)
  writerNetAmount Decimal     @map("writer_net_amount") @db.Decimal(12, 2)
  message         String?     @db.VarChar(500)
  createdAt       DateTime    @default(now()) @map("created_at")

  sender          User        @relation("GiftSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient       User        @relation("GiftRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("gifts")
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REJECTED
}

model Withdrawal {
  id            BigInt           @id @default(autoincrement())
  userId        BigInt           @map("user_id")
  amount        Decimal          @db.Decimal(12, 2)
  bankName      String           @map("bank_name") @db.VarChar(100)
  accountNumber String           @map("account_number") @db.VarChar(30)
  accountName   String           @map("account_name") @db.VarChar(100)
  status        WithdrawalStatus @default(PENDING)
  adminNote     String?          @map("admin_note") @db.Text
  processedAt   DateTime?        @map("processed_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

// ========================================================
// 6. NOTIFICATIONS, REPORTS & AUDIT LOGS
// ========================================================

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  actionUrl String?  @map("action_url") @db.VarChar(500)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum ReportTargetType {
  CONTENT
  COMMENT
  USER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id          BigInt           @id @default(autoincrement())
  reporterId  BigInt           @map("reporter_id")
  targetType  ReportTargetType @map("target_type")
  targetId    BigInt           @map("target_id")
  reason      String           @db.VarChar(100)
  description String?          @db.Text
  status      ReportStatus     @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")

  reporter    User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  adminId       BigInt   @map("admin_id")
  action        String   @db.VarChar(100)
  targetEntity  String   @map("target_entity") @db.VarChar(100)
  targetId      String   @map("target_id") @db.VarChar(100)
  oldValuesJson Json?    @map("old_values_json")
  newValuesJson Json?    @map("new_values_json")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  admin         User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
